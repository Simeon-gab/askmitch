# Copy to .env.local and fill in. Names per docs/README.md — .env.local is
# gitignored; secrets never get committed.

# Supabase (project: askmitch, region eu-west-2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never exposed to the client. Supabase dashboard →
# Project Settings → API keys → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional voucher email — Phase 2)
RESEND_API_KEY=
# Always read from env, never hardcoded. Display name must be ASKMITCH.
# Fallback while domain verification is pending: "ASKMITCH <onboarding@resend.dev>"
EMAIL_FROM="ASKMITCH <hello@askmitch.ng>"

# 6-digit PIN for /redeem (Phase 4)
STAFF_REDEMPTION_PIN=

# org UUID for this deployment (orgs.id of the seeded ASKMITCH row)
NEXT_PUBLIC_EVENT_ORG_ID=
